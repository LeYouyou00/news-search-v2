# 环境变量 - 包含真实 API Key，绝对不能提交
.env
!.env.example

# 数据库文件 - 运行时自动生成，不应版本管理
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.venv/
venv/

# Node
node_modules/
.pnp
.pnp.js

# 构建产物
frontend/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db

# Docker（.dockerignore 需要提交到仓库，供 Docker 构建使用）
!.dockerignore
